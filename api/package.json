{
  "name": "@itsmorio/api",
  "version": "0.8.0-rc.2",
  "description": "Morio Management API",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "vbuild": "MORIO_ESBUILD_VERBOSE=1 node build.mjs",
    "clean": "rimraf dist",
    "dev": "NODE_ENV=development nodemon src/index.mjs --no-warnings",
    "lint": "eslint --fix 'src/**' 'openapi/**' 'config/**' 'shared/**' 'tests/**' 'openapi/**'",
    "prettier": "npx prettier --ignore-unknown --write .",
    "test": "../scripts/testcheck.sh && docker exec -it -e \"MORIO_FQDN=${MORIO_FQDN}\" morio-api node --no-warnings --test-concurrency=1 --test",
    "retest": "../scripts/testcheck.sh && cd .. && npm run redev && ./scripts/sleep 5 && cd - && npm run test"
  },
  "imports": {
    "#config": "./config/index.mjs",
    "#config/flags": "./config/flags.mjs",
    "#config/roles": "./config/roles.mjs",
    "#config/account-statuses": "./config/account-statuses.mjs",
    "#config/services/*": "./config/services/*.mjs",
    "#controllers/*": "./src/controllers/*.mjs",
    "#lib/*": "./src/lib/*.mjs",
    "#routes/*": "./src/routes/*.mjs",
    "#shared/*": "./shared/*.mjs"
  },
  "dependencies": {
    "@otplib/preset-default": "^12.0.1",
    "axios": "^1.8.2",
    "bson": "^6.10.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "glob": "^11.0.1",
    "ioredis": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "is-in-subnet": "^4.0.1",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "minimatch": "^10.0.1",
    "mustache": "^4.2.0",
    "node-forge": "^1.3.1",
    "node-jose": "^2.2.0",
    "openid-client": "^5.7.1",
    "openpgp": "^5.11.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-ldapauth": "^3.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "redoc-express": "^2.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.1"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/certeu/morio.git"
  },
  "author": "CERT-EU <services@cert.europa.eu>",
  "license": "EUPL",
  "bugs": {
    "url": "https://github.com/certeu/morio/issues"
  },
  "homepage": "https://github.com/certeu/morio#readme"
}
